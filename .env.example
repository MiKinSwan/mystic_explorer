# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# Google Maps Platform - needs "Places API (New)" enabled (not the legacy
# Places API), used by app/tools/google_places.py.
GOOGLE_MAPS_API_KEY=your-maps-api-key-here

# Postgres (see app/db/session.py) - used by both the read API and the
# mining pipeline (app/pipeline/mine.py). Requires the postgis extension
# enabled on the database. A free Supabase project works well here - get
# this from Project Settings > Database > Connection string (psycopg,
# keep sslmode=require).
DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres?sslmode=require
